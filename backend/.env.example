# Copy to backend/.env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True

# Leave unset to use SQLite. Example Postgres value:
# DATABASE_URL=postgres://user:password@localhost:5432/shahen

# Leave both unset and OTP codes print to the backend terminal instead of sending.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Raise while testing so the OTP rate limit does not block you.
# THROTTLE_OTP=1000/hour
# THROTTLE_LOGIN=1000/hour
