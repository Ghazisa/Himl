{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shahen-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "himl-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "manage.py",
        "runserver",
        "8000"
      ],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "himl-worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8788"
      ],
      "cwd": "frontend",
      "port": 8788
    }
  ]
}
